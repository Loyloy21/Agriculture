# DEVELOPMENT (copy to .env.local; Expo Go / development builds only).
# Any reachable address works here: the Cloudflare quick tunnel written by scripts/start-cloudflare-quick-tunnel.ps1,
# or a LAN address. These temporary addresses are refused by preview/production builds.
EXPO_PUBLIC_API_URL=https://YOUR_TUNNEL_HOST/CAPSTONE%20AGRICULTURE/api

# PREVIEW / PRODUCTION builds do NOT read this file. Set the permanent public HTTPS address in the EAS environment:
#   eas env:create --environment production --name EXPO_PUBLIC_API_URL --value https://<your-domain>/<path>/api --visibility plaintext
# (and the same for --environment preview). app.config.js stops the build if that address is missing, plain HTTP,
# localhost, a private LAN address or a temporary tunnel. The API address is public by nature; never put a server
# secret, database password or Supabase key in any EXPO_PUBLIC_ variable.

# Optional: tile server for the Android/web registration map (https, must contain {z} {x} {y}). Default: OpenStreetMap standard tiles.
# EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
